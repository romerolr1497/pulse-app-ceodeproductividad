# Pulse — variables de entorno (ejemplo, SIN valores reales).
# Copiá este archivo como .env.local y completá con tus valores.
# Nunca subas .env.local a GitHub (ya está ignorado en .gitignore).

# --- Supabase (base de datos + login) ---
# En Supabase > Project Settings > Data API / API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# --- Web Push / notificaciones (VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=TU_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=TU_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# --- Cron (recordatorios) ---
CRON_SECRET=TU_CRON_SECRET

# --- OpenAI (asistente Beat) ---
OPENAI_API_KEY=TU_OPENAI_API_KEY
